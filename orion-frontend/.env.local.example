# URL base de la API del backend (José). En local apunta a Spring Boot.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WhatsApp de atención (fallback; en runtime se lee de GET /config/publica)
NEXT_PUBLIC_WA_NUMBER=+51999999999

# Capa de mocks MSW: "true" para desarrollar sin backend, "false" para usar el real
NEXT_PUBLIC_API_MOCK=true
