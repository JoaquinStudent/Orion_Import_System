# Plantilla de variables del backend Orión Logistic.
# Copiá este archivo como `.env` (en orion-backend/api/) y poné los valores reales.
# Formato properties (KEY=valor): sin comillas, sin 'export' y SIN comentarios
# en la misma línea del valor (el # quedaría como parte del valor).
# El .env real está en .gitignore; este .example SÍ se versiona.

# --- Base de datos (Supabase PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://<host>:<port>/<db>?user=<usuario>
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Seguridad / JWT ---
# JWT_SECRET: mínimo 32 caracteres (requisito de HS256)
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- Integraciones ---
EXCHANGE_API_KEY=

# --- CORS (orígenes permitidos, separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
